# ob1-deploy fork: upstream ignores supabase/ wholesale, but we track the deploy
# scaffold here. Ignore only CLI scratch + local deploy env. (Cannot re-include with
# !supabase/functions/ once the parent dir is ignored, so we edit the pattern instead.)
